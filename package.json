{
  "name": "ludi",
  "private": true,
  "version": "0.1.0",
  "description": "LUDI — marketplace de reserva de quadras esportivas (Porto Alegre)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "npm run prisma:generate -w @ludi/api",
    "db:migrate": "npm run prisma:migrate -w @ludi/api",
    "db:seed": "npm run prisma:seed -w @ludi/api",
    "db:studio": "npm run prisma:studio -w @ludi/api"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7"
}
