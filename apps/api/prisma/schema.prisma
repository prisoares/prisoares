generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  USER
  PARTNER
}

enum BookingStatus {
  requested
  hold_15m
  accepted
  payment_pending
  confirmed
  expired
  cancelled
  no_show
}

enum PaymentStatus {
  stub
  pending
  paid
  refunded
  failed
}

enum PaymentMethod {
  PIX
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  name         String
  cpf          String   @unique
  passwordHash String
  roles        AccountRole[] @default([USER])
  activeRole   AccountRole   @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedVenues  Venue[]  @relation("VenueOwner")
  bookings     Booking[] @relation("UserBookings")
  partnerBookings Booking[] @relation("PartnerBookings")
}

model Sport {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  iconKey   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  courts Court[]
}

model Venue {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  address      String
  neighborhood String
  city         String   @default("Porto Alegre")
  state        String   @default("RS")
  country      String   @default("BR")
  lat          Float
  lng          Float
  photoUrls    String[]
  active       Boolean  @default(true)
  ownerId      String?
  owner        User?    @relation("VenueOwner", fields: [ownerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courts   Court[]
  bookings Booking[]

  @@index([city, state])
  @@index([lat, lng])
}

model Court {
  id          String   @id @default(cuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sportId     String
  sport       Sport    @relation(fields: [sportId], references: [id])
  name        String
  priceCents  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@index([venueId])
  @@index([sportId])
}

model Booking {
  id              String        @id @default(cuid())
  status          BookingStatus @default(requested)
  userId          String
  user            User          @relation("UserBookings", fields: [userId], references: [id])
  partnerId       String?
  partner         User?         @relation("PartnerBookings", fields: [partnerId], references: [id])
  venueId         String
  venue           Venue         @relation(fields: [venueId], references: [id])
  courtId         String
  court           Court         @relation(fields: [courtId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  holdExpiresAt   DateTime?
  priceCents      Int
  commissionCents Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment Payment?

  @@index([status])
  @@index([venueId, startsAt])
  @@index([userId])
}

/// Payment stub — Asaas Pix wired in later phases.
model Payment {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status          PaymentStatus @default(stub)
  method          PaymentMethod @default(PIX)
  amountCents     Int
  asaasChargeId   String?
  pixCopyPaste    String?
  pixQrCodeBase64 String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
